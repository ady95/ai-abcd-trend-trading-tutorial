# 키움증권 REST API 설정 예시 — 이 파일을 .env로 복사해 값을 채웁니다 (.env는 커밋 금지)
# 모의투자 키: https://openapi.kiwoom.com 에서 모의투자용 앱키 발급
KIWOOM_PAPER_APP_KEY=YOUR_PAPER_APP_KEY
KIWOOM_PAPER_APP_SECRET=YOUR_PAPER_APP_SECRET
KIWOOM_PAPER_ACCOUNT_NO=YOUR_PAPER_ACCOUNT_NO

# 실전 키: 실전 시세 조회(대량 수집) 또는 실거래 검증 단계에서만 채웁니다
KIWOOM_REAL_APP_KEY=
KIWOOM_REAL_APP_SECRET=
KIWOOM_REAL_ACCOUNT_NO=

# paper | real — 주문이 나가는 환경. 실거래 검증 전까지 paper 유지
TRADING_MODE=paper

# KRX 정보데이터시스템 오픈API (3장 대상 종목·거래대금 순위). https://openapi.krx.co.kr 에서 API별 이용 신청
KRX_API_KEY=YOUR_KRX_API_KEY

# DART 전자공시 오픈API (2장 수정주가 사유 조회)
DART_API_KEY=YOUR_DART_API_KEY
